# Local only — skip OTP on register (NEVER on production server)
# SKIP_OTP_VERIFY=1

NODE_ENV=development
PORT=5000

# Process split (speed): all | api | worker
# Local/dev: all (default) — one process does HTTP + background jobs
# Production PM2: api ×1 (default) + worker ×1 via ecosystem.config.cjs
# Optional: API_INSTANCES=2 for cluster (requires Nginx ip_hash sticky sessions)
# PROCESS_ROLE=all
# API_INSTANCES=1

# MongoDB Atlas (no DB path needed — selected via dbName in code)
# production → db "test" | development → db "safeexchange"
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.lzva1gu.mongodb.net/?appName=Cluster0
# Local example:
# MONGODB_URI=mongodb://127.0.0.1:27017
# DB_URL=mongodb://127.0.0.1:27017/vancrypto

JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d

# Withdraw security (direct API abuse protection)
# Require approved KYC before any withdraw (set 0 to disable temporarily)
WITHDRAW_REQUIRE_KYC=1
# Require approved deposit, cash-in deposit, or admin credit before withdraw
WITHDRAW_REQUIRE_FUNDING=1
WITHDRAW_MIN_AMOUNT=1
WITHDRAW_MAX_AMOUNT=100000
WITHDRAW_MAX_PENDING=3
WITHDRAW_RATE_LIMIT_MAX=5

# Frontend origin(s) for CORS — comma-separated, no trailing slashes
# Production (required on server .env):
CORS_ORIGIN=https://safexchange.io,https://www.safexchange.io
FRONTEND_URL=https://www.safexchange.io
# Set to 0 only if not behind a reverse proxy
TRUST_PROXY=1
# OTP rate limits (optional)
# OTP_RATE_LIMIT_PER_MOBILE=5
# OTP_RATE_LIMIT_PER_IP=30
# Local only — skip OTP check on register (never set on production):
# SKIP_OTP_VERIFY=1
# Global API rate limit per IP per 15 min (default 3000 prod / disabled in development)
# API_RATE_LIMIT_MAX=3000
# Set API_RATE_LIMIT_ENFORCE=1 to apply limits in development
# AUTH_LOGIN_RATE_LIMIT_MAX=30

# Public base URL for KYC/deposit file links
API_BASE_URL=http://localhost:5000

# Crypto deposit — platform receiving address
PLATFORM_USDT_ADDRESS=TXyourTRC20AddressOr0xYourERC20Address
PLATFORM_USDT_NETWORKS=TRC20,ERC20

# Fiat deposit — platform bank details (shown to users)
PLATFORM_BANK_NAME=SafeXchange Pvt Ltd
PLATFORM_BANK_ACCOUNT=123456789012
PLATFORM_BANK_IFSC=SBIN0001234
PLATFORM_BANK_HOLDER=SafeXchange

# Optional: seed admin + internal liquidity user (npm run seed)
# ADMIN_EMAIL=admin@safexchange.io
# ADMIN_PASSWORD=Admin123!
SYSTEM_LIQUIDITY_EMAIL=liquidity@internal.safex
SYSTEM_LIQUIDITY_PASSWORD=LiquidityInternal123!

# Free public RPC (treasury sweep / tx verify — not used for auto-deposit credit)
BSC_RPC_URL=https://bsc-dataseed1.binance.org,https://bsc-dataseed2.binance.org
ETH_RPC_URL=https://eth.drpc.org,https://1rpc.io/eth,https://ethereum-rpc.publicnode.com

# Market data — Binance public REST only (prices match Binance exactly)
# Default to the global market-data mirror (data-api.binance.vision) which is
# NOT geo-blocked. The server auto-falls back across Binance mirrors if one
# returns 451/403/429. Set to https://api.binance.com only if your region allows.
BINANCE_API_URL=https://data-api.binance.vision
BINANCE_WS_URL=wss://data-stream.binance.vision
BINANCE_PRICE_CACHE_MS=3000
BINANCE_LIVE_TICKER_MAX_MS=3000
# Realtime stream/chart polling (ms) — WS handles ticks; REST is fallback
MARKET_STREAM_POLL_MS=1000
MARKET_KLINE_POLL_MS=30000
MARKET_LIVE_BAR_MS=3000
MARKET_DEPTH_POLL_MS=5000
MARKET_PERSIST_THROTTLE_MS=2000
MARKET_AGG_TRADE_EVERY_N=3

# CoinGecko — prices/charts for admin-added coins not on Binance
COINGECKO_API_URL=https://api.coingecko.com/api/v3
# COINGECKO_API_KEY=your-coingecko-demo-or-pro-key
# COINGECKO_PRICE_CACHE_MS=12000

# CoinMarketCap — contract token lookup (optional; tried before CoinGecko)
# CMC_API_URL=https://pro-api.coinmarketcap.com
# CMC_API_KEY=your-cmc-pro-api-key

# NinzaSMS — OTP SMS (https://ninzasms.in.net/auth/send_sms)
NINZASMS_API_URL=https://ninzasms.in.net/auth/send_sms
NINZASMS_API_KEY=your-ninzasms-api-key
# Use DLT template id from NinzaSMS panel (recommended) OR sender id:
NINZASMS_TEMPLATE_ID=15582
NINZASMS_SENDER_ID=your-sender-id
NINZASMS_ROUTE=sms
