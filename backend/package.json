{
  "name": "safex-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "PROCESS_ROLE=all node --watch src/server.js",
    "start": "PROCESS_ROLE=all node src/server.js",
    "start:api": "PROCESS_ROLE=api node src/server.js",
    "start:worker": "PROCESS_ROLE=worker node src/worker.js",
    "start:prod": "pm2 start ecosystem.config.cjs",
    "pm2:reload": "pm2 reload ecosystem.config.cjs",
    "seed": "node src/scripts/seed.js",
    "seed:pairs": "node src/scripts/seedTradingPairs.js",
    "seed:staking": "node src/scripts/seedStakingPlans.js",
    "seed:admin": "node src/scripts/seedAdmin.js",
    "db:check": "node src/scripts/check-db.js"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ethers": "^6.17.0",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.3.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.8.1",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  }
